# --- LLM (Groq, free tier: https://console.groq.com/keys) ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=6000

# --- Dataset ---
# The dataset lives as a `purchases` table in the same Supabase Postgres
# instance as `users`/`analysis_runs` below -- see docs/supabase_schema.sql
# and scripts/upload_dataset.py to set it up.
DATASET_TABLE_NAME=purchases
DATASET_MAX_RESULT_ROWS=200

# --- API ---
API_TITLE=Data Analyst Agent
API_VERSION=0.1.0
API_DEBUG=false
SHUTDOWN_GRACE_SECONDS=5

# --- Auth (JWT bearer tokens, issued by /api/v1/auth/register and /login) ---
# Set this in any real deployment -- if left blank, a random key is
# generated per process start, which invalidates every token on restart.
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (Supabase Postgres) ---
# Free-tier direct connections (db.<ref>.supabase.co) are IPv6-only and
# often fail to resolve; use the Session pooler string instead
# (Supabase dashboard -> Connect -> Connection string -> Session pooler).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Cache / rate limiting (optional) ---
# Local Redis container (see docker-compose.yml). Leave blank to fall
# back to in-memory cache + rate limiting -- fine for a single instance,
# just doesn't survive a restart or scale to multiple instances.
# docker-compose sets this automatically to redis://redis:6379/0.
REDIS_URL=

# --- UI ---
UI_API_BASE_URL=http://localhost:8000
UI_REQUEST_TIMEOUT=90

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
